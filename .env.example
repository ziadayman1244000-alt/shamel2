# انسخ الملف ده باسم .env واملا القيم. ماترفعش .env على GitHub أبداً.
# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# قاعدة البيانات MySQL / TiDB (مطلوبة بس لحفظ الملاحظات student_notes)
# لو فيه علامات خاصة في الباسورد حطها بين single quotes زي المثال
DATABASE_URL='mysql://USER:PASSWORD@HOST:4000/DBNAME?ssl={"rejectUnauthorized":true}'

# أي نص عشوائي طويل (32+ حرف) - للـ sessions
JWT_SECRET=change-me-to-a-long-random-string

# البورت (اختياري - الافتراضي 3000)
PORT=3000
